top to bottom direction
actor Donor
actor "Center Staff" as Staff
actor "Center Admin" as Admin
actor "Super Admin" as Super
rectangle Qatra {
 usecase "Manage identity\nand profile" as UC1
 usecase "Manage availability\nand eligibility" as UC2
 usecase "Browse centers and\nmanage appointments" as UC3
 usecase "Respond to\nemergencies" as UC4
 usecase "Check in, screen, and\ncomplete donations" as UC5
 usecase "Manage center, slots,\nstaff, and reports" as UC6
 usecase "Create, track, and\nresolve emergencies" as UC7
 usecase "Govern users, roles,\ncenters, GDPR, and audit" as UC8
 usecase "Match donors and\nsend notifications" as UC9
}
Donor --> UC1
Donor --> UC2
Donor --> UC3
Donor --> UC4
Staff --> UC5
Staff --> UC7
Admin --> UC6
Super --> UC8
UC7 ..> UC9 : <<include>>
UC9 ..> UC2 : <<include>>
@enduml

@startuml kanban-workflow
