@startuml emergency-sequence
!include style.puml
actor Coordinator
actor Donor
participant "Emergency API" as API
participant "Emergency Service" as ES
participant "Matching Engine" as Match
database "Donor / Emergency Repositories" as DB
queue Kafka
participant "Notification Service" as NS
Coordinator -> API : create emergency
API -> ES : validate and persist
ES -> DB : save active emergency
ES -> Match : start matching(emergency)
Match -> DB : query compatible, eligible, available donors
DB --> Match : candidate set
Match -> Match : distance, ranking, tier selection
Match -> Kafka : publish alert intents
Kafka -> NS : consume event
NS -> Donor : alert through allowed channels
Donor -> API : accept or decline
API -> ES : record response
ES -> DB : update progress
ES --> Coordinator : current emergency status
@enduml

@startuml notification-event-flow
!include style.puml
top to bottom direction
[Donation Service] as DS
queue "Kafka Topic" as K
[Notification Consumer] as NC
database "Notification Store" as Store
[Preference Resolver] as Pref
[WebSocket Channel] as WS
[Email Channel] as Mail
[Angular Notification Store] as Angular
cloud "Email Provider" as Provider
component "Retry / Failure Policy" as Retry
DS --> K : event + correlation ID
K --> NC : at-least-once delivery
NC --> Store : deduplicated record
NC --> Pref
Pref --> WS
Pref --> Mail
WS --> Angular
Mail --> Provider
NC --> Retry : temporary error
Retry --> K : bounded retry
@enduml

@startuml cicd-pipeline
!include style.puml
actor Developer
participant GitHub
participant "GitHub Actions" as Actions
participant "Maven Test Matrix" as Tests
participant "Container Registry" as Registry
participant "k3s Server" as K3s
Developer -> GitHub : push or pull request
GitHub -> Actions : trigger path-filtered workflow
Actions -> Tests : run donation and notification tests
alt pull request
  Tests --> Actions : verification result
  Actions --> GitHub : publish check status
else push to master
  Actions -> Registry : build and publish image
  Actions -> K3s : connect through SSH
  K3s -> K3s : import image and restart deployment
  note right of K3s
    Readiness, smoke checks and rollback
    remain recommended hardening steps.
  end note
end
@enduml

