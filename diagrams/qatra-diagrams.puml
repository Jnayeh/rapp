skinparam dpi 190
skinparam backgroundColor white
skinparam defaultFontName "Times New Roman"
skinparam componentBackgroundColor #EFF4F8
skinparam componentBorderColor #264967
left to right direction
actor User
node "Web Tier" {
component "Nginx / Ingress" as Nginx
[Angular 20 SPA] as SPA
}
node "Application Tier" {
[Donation Service\nSpring Boot] as Donation
[Notification Service\nSpring Boot] as Notification
