}
User --> Nginx
Nginx --> SPA
SPA --> Donation : REST / JWT
SPA --> Notification : REST / WebSocket
Donation --> PG
Donation --> K : domain events
Notification --> K : consume
Notification --> PG
Notification --> R
Notification --> WS
Notification --> Email
@enduml

@startuml global-domain-model
!include style.puml
hide circle
top to bottom direction
class User {
  +id: UUID
  +email: String
  +status: AccountStatus
  +role: Role
  +activate()
  +disable()
}
class DonorProfile {
  +bloodType: BloodType
  +available: boolean
  +eligibleFrom: LocalDate
  +reliabilityScore: int
  +updateAvailability()
  +isEligibleOn(date)
}
class HealthQuestionnaire {
  +updatedAt: Instant
  +restrictionStatus: RestrictionStatus
  +evaluateRestrictions()
}
class DonationCenter {
  +id: UUID
  +name: String
  +status: CenterStatus
  +location: GeoPoint
  +approve()
  +publishSlots()
}
class StaffProfile {
  +role: StaffRole
  +active: boolean
  +assignToCenter()
}
class Slot {
  +startTime: Instant
  +capacity: int
  +state: SlotState
  +reserve()
  +release()
}
class Appointment {
  +id: UUID
  +scheduledAt: Instant
  +status: AppointmentStatus
  +outcome: DonationOutcome
  +confirm()
  +complete()
}
class HealthScreening {
  +decision: ScreeningDecision
  +recordedAt: Instant
  +recordDecision()
}
class Emergency {
  +id: UUID
  +bloodType: BloodType
  +deadline: Instant
  +status: EmergencyStatus
  +location: GeoPoint
  +activate()
  +resolve()
}
class EmergencyResponse {
  +decision: ResponseDecision
  +respondedAt: Instant
  +accept()
  +decline()
}
class Notification {
  +channel: NotificationChannel
  +status: DeliveryStatus
  +createdAt: Instant
  +markDispatched()
}
class AuditLog {
  +actorId: UUID
  +action: String
  +timestamp: Instant
  +record()
}
User "1" -- "0..1" DonorProfile : owns
User "1" -- "0..*" StaffProfile : identifies
User "1" -- "0..*" AuditLog : produces
DonorProfile "1" *-- "0..1" HealthQuestionnaire : completes
DonationCenter "1" *-- "0..*" StaffProfile : employs
DonationCenter "1" *-- "0..*" Slot : publishes
DonorProfile "1" -- "0..*" Appointment : books
Slot "1" -- "0..*" Appointment : schedules
Appointment "1" *-- "0..1" HealthScreening : records
DonationCenter "1" -- "0..*" Emergency : coordinates
Emergency "1" *-- "0..*" EmergencyResponse : collects
DonorProfile "1" -- "0..*" EmergencyResponse : submits
Emergency "1" -- "0..*" Notification : triggers
@enduml

@startuml appointment-activity
!include style.puml
start
:Browse centers and available slots;
:Select slot and submit booking;
:Authenticate donor;
if (Profile and eligibility valid?) then (yes)
  :Lock and recheck slot capacity;
  if (Capacity available?) then (yes)
    :Create appointment;
    :Publish confirmation event;
    :Receive confirmation;
    :Check in donor on appointment day;
    :Record health screening;
    if (Screening accepted?) then (yes)
      :Complete donation;
      :Update history and next eligibility date;
      :Publish completion notification;
    else (no)
      :Record deferral outcome;
    endif
  else (no)
    :Return slot conflict;
  endif
else (no)
  :Reject booking with validation reason;
endif
stop
@enduml

@startuml emergency-matching-activity
!include style.puml
start
:Create emergency request;
:Validate blood need, location and deadline;
:Activate emergency;
:Load active donor candidates;
:Filter compatibility, eligibility and availability;
:Calculate distance and rank candidates;
repeat
  :Select uncontacted donors in current radius;
  :Create idempotent notification intents;
  :Dispatch through allowed channels;
  :Collect accept or decline responses;
  if (Required response reached?) then (yes)
    :Mark emergency matched;
    break
  else (no)
    :Expand radius within policy;
  endif
repeat while (Time and radius remain?) is (yes)
if (Matched?) then (yes)
  :Coordinate confirmed donors;
else (no)
  :Escalate or expire request;
endif
stop
@enduml

@startuml authentication-sequence
!include style.puml
actor User
participant "Angular App" as SPA
participant "Auth Controller" as API
participant "Authentication Service" as Auth
database "User Repository" as DB
participant "JWT Service" as JWT
User -> SPA : submit email and password
SPA -> API : POST login
API -> Auth : authenticate(credentials)
Auth -> DB : find active user
DB --> Auth : user and password hash
Auth -> Auth : verify password and status
Auth -> JWT : issue signed token
JWT --> API : access token
API --> SPA : authenticated response
SPA -> API : protected request + Bearer token
API -> JWT : validate signature and expiry
JWT --> API : identity and roles
API --> SPA : authorized resource
@enduml

@startuml security-flow
!include style.puml
start
:Receive HTTP request;
if (Bearer token present?) then (yes)
  :Validate signature and expiry;
  if (Account and token valid?) then (yes)
    :Build security context;
    if (Role authorized?) then (yes)
      if (Resource scope valid?) then (yes)
        :Execute use case;
      else (no)
        :Return 403 Forbidden;
      endif
    else (no)
      :Return 403 Forbidden;
    endif
  else (no)
    :Return 401 Unauthorized;
  endif
else (no)
  :Allow public endpoint or return 401;
endif
stop
@enduml

@startuml appointment-sequence
!include style.puml
actor Donor
actor Staff
participant "Angular App" as UI
participant "Appointment API" as API
participant "Appointment Service" as Service
database "Appointment / Slot Repositories" as DB
Donor -> UI : choose center, date, and slot
UI -> API : create appointment
API -> Service : validate donor and request
Service -> DB : lock/check slot and conflicts
DB --> Service : available
Service -> DB : save appointment atomically
DB --> Service : confirmed appointment
Service --> UI : confirmation
Staff -> UI : check in donor
UI -> API : update status and screening
API -> Service : authorize center staff
Service -> DB : save screening and outcome
Service -> DB : update history and eligibility
Service --> UI : completed workflow
@enduml

