' Qatra report diagrams - editable PlantUML source
' Each diagram uses a restrained blue-gray academic style.

@startuml technology-stack
!theme plain
skinparam dpi 180
skinparam backgroundColor white
skinparam defaultFontName "Times New Roman"
skinparam componentBackgroundColor #EFF4F8
skinparam componentBorderColor #264967
left to right direction
package "Experience" {
[Angular 20] as Angular
component "PrimeNG / MapLibre / Chart.js" as UI
}
package "Application" {
[Java 21] as Java
[Spring Boot 4] as Spring
component "Spring Security / JPA / WebSocket" as Boot
}
package "Data and Events" {
database PostgreSQL
queue Kafka
database Redis
}
package "Delivery" {
[Docker] as Docker
component "k3s / Kubernetes" as K3s
component "GitHub Actions / GHCR" as CI
}
package "Observability" {
component "Prometheus / Grafana" as Metrics
component "Loki / Promtail" as Logs
[Jaeger] as Traces
}
Angular --> Spring
UI --> Angular
Spring --> PostgreSQL
Spring --> Kafka
Spring --> Redis
CI --> Docker
Docker --> K3s
K3s --> Metrics
K3s --> Logs
K3s --> Traces
@enduml

@startuml global-use-case
